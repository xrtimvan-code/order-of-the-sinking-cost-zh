{
  "name": "order-of-the-sinking-cost",
  "private": true,
  "description": "《沉星之序》非官方简体中文进度查看器：本地读取存档，查看进度、地图与解锁路线",
  "repository": "github:xrtimvan-code/order-of-the-sinking-cost-zh",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:standalone": "vp build && node scripts/build-standalone.mjs",
    "deploy": "vp build && wrangler deploy",
    "test": "vp test",
    "lint": "vp lint",
    "typecheck": "vp check --no-fmt --no-lint",
    "fmt": "vp fmt src tests scripts vite.config.ts",
    "fmt:check": "vp fmt --check src tests scripts vite.config.ts",
    "docs:check": "node scripts/check-docs.ts",
    "dump:model": "node scripts/dump-model.ts",
    "icons": "node scripts/build-icons.ts",
    "data": "npm run data:levels && npm run data:areas && npm run data:fog && npm run data:world && npm run data:map && npm run data:progress && npm run data:walk",
    "data:levels": "node scripts/build-levels.ts",
    "data:areas": "node scripts/build-areas.ts",
    "data:fog": "node scripts/build-fog.ts",
    "data:world": "node scripts/build-world.ts",
    "data:map": "node scripts/build-map.ts",
    "data:progress": "node scripts/build-progress.ts",
    "data:walk": "node scripts/build-walk.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vite-plus": "1.0.0",
    "wrangler": "^4.151.1"
  }
}
